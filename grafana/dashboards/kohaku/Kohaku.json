        {
          "datasource": {
            "type": "motherduck-duckdb-datasource"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "WITH term AS (\nSELECT\n  connection_id,\n  MAX(timestamp) AS last_time,\n  MAX((rtc_data->>'$.timestamp') :: double) AS last_rtc_data_time,\n  MIN(timestamp) AS first_time,\n  MIN((rtc_data->>'$.timestamp') :: double) AS first_rtc_data_time\nFROM rtc_stats\nWHERE $__timeFilter(timestamp)\nGROUP BY connection_id\n)\nSELECT\n  DISTINCT s.timestamp AS created_timestamp,\n  s.channel_id,\n  s.session_id,\n  s.client_id,\n  s.connection_id,\n  t.last_rtc_data_time,\n  -- Data links に設定する from パラメータ用にミリ秒のタイムスタンプを生成\n  (EXTRACT(EPOCH FROM t.first_time) :: bigint * 1000) :: bigint AS from_time,\n  -- Data links に設定する to パラメータ用にミリ秒のタイムスタンプを生成\n  (EXTRACT(EPOCH FROM t.last_time) :: bigint * 1000) :: bigint AS to_time\nFROM term t\nINNER JOIN rtc_stats s ON\n      (t.connection_id = s.connection_id)\n  AND (t.last_rtc_data_time = ((s.rtc_data->>'$.timestamp') :: double))\nWHERE $__timeFilter(timestamp)\nORDER BY timestamp DESC\nOFFSET ${offset}\nLIMIT ${limit};",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Latest connections",
      "type": "table"
    }
