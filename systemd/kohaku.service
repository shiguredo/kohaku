[Unit]
# Kohaku の ingester 更新サービス
Description=WebRTC Stats Analyzer Kohaku
# network-online.target を起動対象に含める
Wants=network-online.target
# ネットワークがオンラインになった後に起動する
After=network-online.target

[Service]
# 一度実行して終了するタイプ
Type=oneshot
# 実行ユーザー
User=kohaku
# 初回読み込み時の最大件数
Environment=INITIAL_MAXIMUM_LOAD=100
# update 1 回あたりの最大読み込み件数
Environment=UPDATE_MAXIMUM_LOAD=100
# 環境変数を読み込むファイル
EnvironmentFile=/opt/kohaku/.env
# uv のキャッシュディレクトリ
Environment=UV_CACHE_DIR=/opt/kohaku/ingester/.cache
# ホームディレクトリ
Environment=HOME=/opt/kohaku
# 作業ディレクトリ
WorkingDirectory=/opt/kohaku/ingester
# 起動処理のタイムアウト
TimeoutStartSec=10min
# DuckDB ファイルがない場合は init 前としてスキップする。DUCKDB_DB_PATH 未定義
# はユニット失敗として Restart=on-failure と journalctl に確実に残す。
# ExecCondition の中で :? を使うと条件未成立によるスキップ扱いになり、
# ユニット失敗にならない。ExecCondition は ExecStartPre より先に走るため、
# ExecCondition 側で未定義を通過させて ExecStartPre で失敗判定する構成に分ける。
ExecCondition=/bin/sh -c '[ -z "${DUCKDB_DB_PATH:-}" ] || test -f "${DUCKDB_DB_PATH}"'
ExecStartPre=/bin/sh -c ': "${DUCKDB_DB_PATH:?DUCKDB_DB_PATH is required}"'
# ingester の更新処理を実行する
ExecStart=/bin/sh /opt/kohaku/scripts/run-ingester.sh update
# 更新処理完了後に古いデータを削除する
ExecStartPost=/bin/sh /opt/kohaku/scripts/run-ingester.sh delete

# 失敗時のみ再起動する
Restart=on-failure
# 再起動までの待機時間
RestartSec=5min

[Install]
# multi-user.target で有効化する
WantedBy=multi-user.target
